{
  "name": "avis-doctolib-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "cd apps/backend && npm run dev",
    "start:backend": "cd apps/backend && npm start",
    "dev:admin": "cd apps/reputy-admin && npm run dev",
    "build:admin": "cd apps/reputy-admin && npm run build",
    "lint:admin": "cd apps/reputy-admin && npm run lint",
    "dev:web": "cd apps/reputy-web && npm run dev",
    "build:web": "cd apps/reputy-web && npm run build",
    "start:web": "cd apps/reputy-web && npm run start",
    "dev:extension": "echo \"Charger l'extension Chrome depuis apps/extension (mode dév MV3).\"",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:admin\" \"npm run dev:web\"",
    "install:all": "npm install && cd apps/reputy-admin && npm install && cd ../reputy-web && npm install && cd ../backend && npm install",
    "clean": "rm -rf node_modules .turbo && rm -rf apps/*/node_modules apps/*/.next apps/*/out apps/*/dist apps/*/.turbo",
    "guard:secrets": "node scripts/check-no-secrets.js",
    "pack:safe": "zip -r reputy-clean.zip . -x \"*/node_modules/*\" \"*/.next/*\" \"*/out/*\" \"*/dist/*\" \"*/.turbo/*\" \".git/*\" \".env*\" \"*.log\" \"*.db\" \"*.db-wal\" \"*.db-shm\" \"*.sqlite\" \"data.json\" \"debug-org.js\" \"check-org-billing.js\"",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:dev": "pm2 start ecosystem.config.cjs",
    "pm2:logs": "pm2 logs reputy-backend --lines 100",
    "pm2:stop": "pm2 stop reputy-backend",
    "pm2:restart": "pm2 restart reputy-backend",
    "pm2:status": "pm2 status",
    "db:backup": "node scripts/db-backup.js",
    "db:restore": "node scripts/db-restore.js",
    "db:backup:verify": "node scripts/db-backup-verify.js"
  }
}

