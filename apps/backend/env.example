# ============================================================
# REPUTY BACKEND - Environment Variables
# Version: 3.0.0 - Brevo + AI + Resilience
# ============================================================
# Copy this file to .env and fill in the values
# Generate secrets with: openssl rand -base64 32

# ============ SERVER ============
PORT=8787
NODE_ENV=development
REPUTY_STORAGE=sqlite

# ============ AUTHENTICATION ============
# API token for extension authentication
# Generate with: openssl rand -base64 24
CABINET_API_TOKEN=

# P4: Legacy grace period token (optional)
# Set this to the OLD token value during rotation, remove after 24-48h.
# CABINET_API_TOKEN_OLD=

# Internal admin token for backoffice
# Generate with: openssl rand -base64 24
INTERNAL_ADMIN_TOKEN=

# JWT secret for session tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Admin cookie secret
# Generate with: openssl rand -base64 32
ADMIN_COOKIE_SECRET=

# ============ URLS ============
# Base URL for review pages (patient-facing)
REVIEWS_BASE_URL=http://127.0.0.1:8787

# Admin dashboard URL
REPUTY_DOMAIN=http://localhost:3002

# Public website URL
REPUTY_WEB_URL=http://localhost:3001

# ============ CORS ============
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3000,http://127.0.0.1:3001

# ============ BILLING - STRIPE ============
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Get this from Stripe Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# ────────────────────────────────────────────────────────────────
# SUBSCRIPTION PLANS (create in Stripe Dashboard > Products)
# ────────────────────────────────────────────────────────────────

# Pack Argent: 59€ HT/month (100 SMS, 500 emails, 3 QR, 1 NFC)
STRIPE_PRICE_ID_SILVER=price_...

# Pack Or: 99€ HT/month (200 SMS, 1000 emails, 75 IA, 10 QR, 3 NFC)
STRIPE_PRICE_ID_GOLD=price_...

# Pack Platinum: 149€ HT/month (400 SMS, 2000 emails, 150 IA, 10 QR, 3 NFC)
STRIPE_PRICE_ID_PLATINUM=price_...

# ────────────────────────────────────────────────────────────────
# PACK PURCHASES (one-time, create as "Products" with type "one-time")
# ────────────────────────────────────────────────────────────────

# SMS Packs
STRIPE_PRICE_SMS_150=price_...    # 150 SMS → 29€ HT
STRIPE_PRICE_SMS_300=price_...    # 300 SMS → 49€ HT

# Email Packs
STRIPE_PRICE_EMAIL_1000=price_... # 1000 emails → 19€ HT
STRIPE_PRICE_EMAIL_2000=price_... # 2000 emails → 39€ HT

# IA Packs (réponses automatiques aux avis)
STRIPE_PRICE_IA_MINI=price_...    # 25 réponses IA → 19€ HT
STRIPE_PRICE_IA_MAXI=price_...    # 75 réponses IA → 39€ HT

# QR & NFC (one-time)
STRIPE_PRICE_QR_EXTRA=price_...   # QR Code (500 scans) → 5€ HT
STRIPE_PRICE_NFC_EXTRA=price_...  # Tag NFC (500 scans) → 15€ HT

# ============ BILLING - GOCARDLESS (SEPA) ============
# Get these from https://manage.gocardless.com/developers
GOCARDLESS_ACCESS_TOKEN=sandbox_...
GOCARDLESS_WEBHOOK_SECRET=...
GOCARDLESS_ENVIRONMENT=sandbox

# ============ EMAIL (Brevo) ============
# Provider: brevo_api (recommended) or smtp
EMAIL_PROVIDER=brevo_api
EMAIL_FROM=Reputy <noreply@reputy.fr>
EMAIL_DRY_RUN=true

# Support email for billing notifications
SUPPORT_BILLING_EMAIL=support@reputy.fr

# SMTP configuration (only if EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email
# SMTP_PASS=your-password

# ============ SMS (Brevo) ============
SMS_PROVIDER=brevo
SMS_DRY_RUN=true
BREVO_SMS_SENDER=Reputy

# ============ BREVO API ============
# Get from https://app.brevo.com/settings/keys/api
# Used for both email (REST API) and SMS
BREVO_API_KEY=

# ============ OPENAI (AI Auto-Replies) ============
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_AUTO_REPLY_MODEL=gpt-4.1-mini

# ============ GOOGLE BUSINESS PROFILE ============
# Get these from https://console.cloud.google.com/apis/credentials
# Required: Enable "Google Business Profile APIs" in your project
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/google/oauth/callback

# Encryption key for storing Google OAuth tokens at rest (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_ENCRYPTION_KEY=

# ============ GOOGLE PLACES API (Competitors) ============
# Get from https://console.cloud.google.com/apis/credentials
# Required: Enable "Places API (New)" in your project
GOOGLE_PLACES_API_KEY=

# ============ MONITORING — SENTRY ============
# Get DSN from https://sentry.io → Project Settings → Client Keys
# Leave empty to disable Sentry (no-op mode)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=unknown

# ============ SECURITY ============
# IP allowlist for internal API (optional, comma-separated)
# INTERNAL_API_ALLOWED_IPS=127.0.0.1,::1

# Rate limiting (defaults shown)
# AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
# AUTH_RATE_LIMIT_WINDOW_MS=60000

# ============ KILL SWITCHES ============
# P1.6: Emergency messaging kill switch
# Set to "1" or "true" to disable ALL SMS/email sends (workers exit immediately)
MESSAGING_DISABLED=0

# P5: Legacy auth kill switch (optional, prod only)
# Set to "1" to disable legacy validateAuth (global CABINET_API_TOKEN auth).
DISABLE_LEGACY_AUTH=0

# ============ RESILIENCE (optional) ============
# Circuit breaker jitter in ms (default: 30000)
# CB_JITTER_MS=30000

# Watchdog JSON output mode (default: false)
# WATCHDOG_JSON=false
